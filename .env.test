# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'

# A database of its own, and this is the important line in the file.
#
# The integration and acceptance suites truncate tables. Without this they inherit MYSQL_DB
# from .env - the development database - and running `make test` empties whatever campaigns and
# accounts happened to be in it. That has been a trap for anybody who ran the suite without
# knowing, which is everybody the first time.
#
# Only the name is set here. The host and the credentials still come from .env, so a developer's
# own setup keeps working; CI overrides those three in .env.test.local because its database is
# a service container rather than the dev one.
#
# Create it once with: make test-db
MYSQL_DB=wargames_test
APP_SECRET='$ecretf0rt3st'
JWT_SECRET='$ecretf0rt3st-jwt-that-is-at-least-32-characters-long'
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=2592000
SENTRY_DSN=
LOKI_URL=
LOKI_USERNAME=
LOKI_PASSWORD=
# No SMTP in tests: the EmailSender port is swapped for a spy (see services.yaml when@test),
# so nothing ever reaches this transport - it is only here to keep the container bootable.
MAILER_DSN=null://null
MAILER_FROM_ADDRESS=no-reply@wargames.test
MAILER_FROM_NAME='Wargames'
ACTIVATION_URL_BASE=http://localhost/activate-account
ACTIVATION_TOKEN_TTL=86400
PASSWORD_RESET_URL_BASE=http://localhost/reset-password
PASSWORD_RESET_TOKEN_TTL=3600
# Host-only, insecure cookies in tests: the kernel browser speaks plain HTTP, and a Secure
# cookie would simply never come back.
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost
TRUSTED_PROXIES=

# Billing is not exercised against the real Stripe in tests: no keys means an empty catalogue
# and a webhook that rejects everything, which is exactly what the suite asserts.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_RETURN_URL=http://localhost/dashboard
